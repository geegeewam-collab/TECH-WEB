NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP=
# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_. Anyone holding it can read all data.
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated emails allowed into /admin
ADMIN_EMAILS=you@example.com
# Optional email alert for each new enquiry (resend.com)
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL="GEEGEE TECH <enquiries@your-domain.com>"
# Printed on invoices (copied onto each invoice when created)
PAYMENT_INSTRUCTIONS="M-Pesa Paybill/Till ... Account ... or bank details"
PAYMENT_TERMS_DAYS=14
# Optional ad tracking (public IDs; nothing loads until the visitor accepts the cookie banner)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GADS_ID=
NEXT_PUBLIC_GADS_LABEL=
NEXT_PUBLIC_META_PIXEL_ID=
