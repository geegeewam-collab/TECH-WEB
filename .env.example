# Public site URL (used for sitemap and metadata)
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# Optional public contact details. Empty values hide the related buttons.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP=
# Enquiry emails (server-side only). Create a key at resend.com and verify your domain.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL="GEEGEE STUDIOS <enquiries@your-domain.com>"
